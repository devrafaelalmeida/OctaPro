{
    "name": "OctaPro Backend",
    "dockerComposeFile": "../docker-compose.yml",
    "service": "backend",
    "workspaceFolder": "/app/backend",
    "shutdownAction": "none",
    "overrideCommand": false,
    "runServices": [
        "octapro-pg-container",
        "backend",
        "frontend"
    ],
    "customizations": {
        "vscode": {
            "settings": {
                "dotnet.defaultSolution": "OctaPro.sln"
            },
            "extensions": [
                "ms-dotnettools.csharp",
                "ms-dotnettools.csdevkit"
            ]
        }
    }
}
