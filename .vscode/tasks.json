{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "command": "docker",
            "type": "process",
            "args": [
                "compose",
                "exec",
                "-w",
                "/app/backend",
                "dev-env",
                "dotnet",
                "build",
                "OctaPro.sln",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary;ForceNoAlign"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "publish",
            "command": "docker",
            "type": "process",
            "args": [
                "compose",
                "exec",
                "-w",
                "/app/backend",
                "dev-env",
                "dotnet",
                "publish",
                "OctaPro.sln",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary;ForceNoAlign"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "watch",
            "command": "docker",
            "type": "process",
            "args": [
                "compose",
                "exec",
                "-w",
                "/app/backend",
                "dev-env",
                "dotnet",
                "watch",
                "run",
                "--project",
                "OctaPro.csproj",
                "--no-hot-reload"
            ],
            "isBackground": true,
            "problemMatcher": {
                "owner": "custom",
                "pattern": {
                    "regexp": "^.*$",
                    "message": 1
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^.*dotnet watch.*",
                    "endsPattern": "^.*Now listening on:.*$"
                }
            }
        }
    ]
}
